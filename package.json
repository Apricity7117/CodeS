{
  "name": "@voeid/codes",
  "version": "0.1.87",
  "description": "CodeS is a lightweight web interface for Codex that runs on top of the Codex app-server, allowing remote access from any browser",
  "type": "module",
  "license": "MIT",
  "author": "Pavel Voronin, Igor Levochkin",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "codex",
    "openai",
    "web-ui",
    "remote",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "codes": "dist-cli/index.js"
  },
  "files": [
    "configs/runtime_defaults.json",
    "dist/",
    "dist-cli/",
    "scripts/dev.cjs",
    "scripts/env.cjs"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:open": "pnpm run build:cli && sh -c 'pnpm run dev & VPID=$!; node dist-cli/index.js --open-project \"${1:-.}\"; wait $VPID' --",
    "typecheck": "pnpm run typecheck:frontend && pnpm run typecheck:server && pnpm run typecheck:config",
    "typecheck:frontend": "vue-tsc --noEmit -p tsconfig.app.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "typecheck:config": "tsc --noEmit -p tsconfig.node.json",
    "build:frontend": "pnpm run typecheck:frontend && vite build",
    "build:cli": "tsup",
    "build": "pnpm run typecheck && vite build && pnpm run build:cli",
    "test:unit": "vitest run",
    "preview": "vite preview",
    "prepublishOnly": "pnpm run build",
    "profile:browser": "node scripts/profile-browser-runtime.cjs",
    "profile:thread": "PROFILE_ROUTE='#/thread/019da7c0-4e12-7a91-837c-f7c11cc8ab6c' node scripts/profile-browser-runtime.cjs"
  },
  "dependencies": {
    "@floating-ui/vue": "^1.1.11",
    "@tabler/icons-vue": "^3.44.0",
    "@vueuse/core": "^14.3.0",
    "commander": "^13.1.0",
    "express": "^5.1.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "markdown-it": "^14.3.0",
    "markdown-it-task-lists": "^2.1.1",
    "reka-ui": "^2.9.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/express": "^5.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "playwright": "^1.59.1",
    "tailwindcss": "^4.1.18",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.5",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.2.0"
  }
}
